# FULFILL-X Master Repository Git Ignore

# Environment & Secret Protection
.env
.env.*
!.env.example
*.pem
*.key
secrets/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
!.env.production.example

# Python Runtime & Virtual Environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
sdist/
.venv/
venv/
env/
ENV/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
.pnp
.pnp.js
.npm
.yarn/
*.tgz

# IDE & OS Configuration
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing, Code Quality & Coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Terraform & AWS Artifacts
infra/terraform/.terraform/
infra/terraform/*.tfstate
infra/terraform/*.tfstate.backup
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infrastructure/cdk.out/
infrastructure/.cdk.staging/

# Application Logs & Temporary Data
*.log
logs/
data/raw/
data/cache/
*.parquet
*.arrow
artifacts/scratch/
