# FULFILL-X Backend Production Environment Example
# Copy to .env for local environment configuration

APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=mock
WEBSOCKET_ENABLED=true
EVALUATION_ENABLED=true
API_PREFIX=/api
APP_VERSION=0.13.0

# Optional Provider Credentials (Do NOT commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
